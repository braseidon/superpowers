#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not HEAD~1) keeps multi-commit
# tasks intact.
#
# Usage: review-package PLAN_FILE BASE HEAD [OUTFILE] [-- PATHSPEC...]
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/review-<base7>..<head7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
#
# Pathspecs after `--` scope the Diff section only; the stat summary always
# covers the whole range, and every changed file the pathspec drops is listed
# by full path (with the commits that touched it) in the package AND warned
# on stderr — a scoped package can never lose a file silently. Derive the
# pathspec from the implementer's own commits, never from plan metadata:
#   review-package plan.md BASE HEAD -- $(git show --name-only --format= SHA1 SHA2)
# Or keep a committed generated artifact out of the body a reviewer must read:
#   review-package plan.md BASE HEAD -- . ':(exclude)tests/fixtures/big.golden.json'
set -euo pipefail

args=()
paths=()
while [ $# -gt 0 ]; do
  if [ "$1" = "--" ]; then
    shift
    paths=("$@")
    break
  fi
  args+=("$1")
  shift
done
set -- ${args[@]+"${args[@]}"}

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE] [-- PATHSPEC...]" >&2
  exit 2
fi

plan=$1
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

excluded=()
kept_count=0
if [ ${#paths[@]} -gt 0 ]; then
  kept_count=$(git diff --name-only "${base}..${head}" -- "${paths[@]}" | wc -l | tr -d ' ')
  while IFS= read -r f; do
    [ -n "$f" ] && excluded+=("$f")
  done < <(comm -23 <(git diff --name-only "${base}..${head}" | sort) \
                    <(git diff --name-only "${base}..${head}" -- "${paths[@]}" | sort))
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  if [ ${#paths[@]} -gt 0 ]; then
    echo "## Excluded from the diff body by pathspec (${#excluded[@]} of $((kept_count + ${#excluded[@]})) changed files)"
    echo "Scoped to: ${paths[*]}"
    if [ ${#excluded[@]} -gt 0 ]; then
      echo "These files changed in the range but are NOT in the diff below. Each shows the commit(s) that touched it:"
      for f in "${excluded[@]}"; do
        echo "- ${f}  ($(git log --format=%h "${base}..${head}" -- "$f" | paste -sd " "))"
      done
    else
      echo "(none — every changed file is in the diff body)"
    fi
    echo
  fi
  echo "## Diff"
  if [ ${#paths[@]} -gt 0 ]; then
    git diff -U10 "${base}..${head}" -- "${paths[@]}"
  else
    git diff -U10 "${base}..${head}"
  fi
} > "$out"

commits=$(git rev-list --count "${base}..${head}")
bytes=$(wc -c < "$out" | tr -d ' ')
lines=$(wc -l < "$out" | tr -d ' ')
echo "wrote ${out}: ${commits} commit(s), ${lines} lines, ${bytes} bytes"

if [ ${#paths[@]} -gt 0 ] && [ "$kept_count" -eq 0 ]; then
  echo "WARNING: diff body is EMPTY — the pathspec matched none of the changed files. Wrong task files?" >&2
fi
if [ ${#excluded[@]} -gt 0 ]; then
  echo "WARNING: ${#excluded[@]} changed file(s) fall outside the pathspec and are NOT in the diff body:" >&2
  for f in "${excluded[@]}"; do
    echo "  ${f}  ($(git log --format=%h "${base}..${head}" -- "$f" | paste -sd " "))" >&2
  done
  echo "  Any of these in the implementer's own commits (tests in a sibling __tests__/ are the usual miss) = the reviewer never sees them." >&2
  echo "  Rescope from the commits, not the plan: $0 $plan $base $head -- \$(git show --name-only --format= <implementer shas>)" >&2
fi

if [ "$lines" -gt 2000 ]; then
  echo "WARNING: ${lines} lines exceeds the 2000-line default Read limit — a reviewer reading this in one call gets it TRUNCATED MID-HUNK with no error." >&2
  echo "  Tell the reviewer the expected line count (${lines}) so it can detect its own truncation, and to read the changed files from disk if its read falls short." >&2
fi

if [ "$bytes" -gt 400000 ]; then
  echo "WARNING: ${bytes} bytes is too large to Read in one call." >&2
  if [ "$commits" -gt 3 ]; then
    echo "  ${commits} commits in this range — if anything else commits to this checkout, most are probably not this task's." >&2
    echo "  Scope to the implementer's commits (preferred): $0 $plan $base $head -- \$(git show --name-only --format= <implementer shas>)" >&2
  fi
  echo "  Or exclude a committed generated artifact: $0 $plan $base $head -- . ':(exclude)<path/to/generated.json>'" >&2
fi
