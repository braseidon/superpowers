#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not HEAD~1) keeps multi-commit
# tasks intact.
#
# Usage: review-package PLAN_FILE BASE HEAD [OUTFILE] [-- PATHSPEC...]
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/review-<base7>..<head7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
#
# Pathspecs after `--` scope the Diff section only; the stat summary always
# covers the whole range, so an excluded file still shows as changed. Use this
# to keep a committed generated artifact out of the body a reviewer must read:
#   review-package plan.md BASE HEAD -- . ':(exclude)tests/fixtures/big.golden.json'
set -euo pipefail

args=()
paths=()
while [ $# -gt 0 ]; do
  if [ "$1" = "--" ]; then
    shift
    paths=("$@")
    break
  fi
  args+=("$1")
  shift
done
set -- ${args[@]+"${args[@]}"}

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE] [-- PATHSPEC...]" >&2
  exit 2
fi

plan=$1
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  if [ ${#paths[@]} -gt 0 ]; then
    echo "Scoped to: ${paths[*]}"
    echo "Files in the stat summary above but absent below were excluded from the diff body."
    echo
    git diff -U10 "${base}..${head}" -- "${paths[@]}"
  else
    git diff -U10 "${base}..${head}"
  fi
} > "$out"

commits=$(git rev-list --count "${base}..${head}")
bytes=$(wc -c < "$out" | tr -d ' ')
echo "wrote ${out}: ${commits} commit(s), ${bytes} bytes"

if [ "$bytes" -gt 400000 ]; then
  echo "WARNING: ${bytes} bytes is too large to Read in one call." >&2
  if [ "$commits" -gt 3 ]; then
    echo "  ${commits} commits in this range — if anything else commits to this checkout, most are probably not this task's." >&2
    echo "  Scope to the task's own files (preferred): $0 $plan $base $head -- <task files>" >&2
  fi
  echo "  Or exclude a committed generated artifact: $0 $plan $base $head -- . ':(exclude)<path/to/generated.json>'" >&2
fi
